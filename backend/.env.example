# Server Configuration
PORT=3001
NODE_ENV=development
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
# Docker Compose maps MongoDB to port 27018 by default
MONGO_DB=mongodb://127.0.0.1:27018/kiosk

# Redis Configuration (BullMQ & Cache)
# Docker Compose maps Redis to port 6380 by default
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# MinIO Object Storage Configuration
# Docker Compose maps MinIO API to port 9002 and Console to 9003
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=srm-fresher-images

# Kiosk Authentication Credentials
KIOSK_USERNAME=admin
KIOSK_PASSWORD=secretpassword
